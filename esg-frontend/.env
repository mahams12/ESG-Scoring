# Application Configuration
REACT_APP_APP_NAME=ESG AI Bot
REACT_APP_VERSION=1.0.0
REACT_APP_DESCRIPTION=ESG Investment Research System

# API Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_TIMEOUT=30000
REACT_APP_API_RETRY_ATTEMPTS=3

# Feature Flags
REACT_APP_ENABLE_MOCK_DATA=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_ERROR_REPORTING=false
REACT_APP_ENABLE_PWA=true

# Authentication (for future implementation)
REACT_APP_AUTH_PROVIDER=local
REACT_APP_SESSION_TIMEOUT=3600000

# External Services (when needed)
# REACT_APP_GOOGLE_ANALYTICS_ID=
# REACT_APP_SENTRY_DSN=
# REACT_APP_HOTJAR_ID=

# Development Configuration
REACT_APP_LOG_LEVEL=info
REACT_APP_ENABLE_DEVTOOLS=true

# Environment
NODE_ENV=development

# Build Configuration
GENERATE_SOURCEMAP=true
INLINE_RUNTIME_CHUNK=false

# Performance
REACT_APP_BUNDLE_ANALYZER=false

# Security
DANGEROUSLY_DISABLE_HOST_CHECK=false